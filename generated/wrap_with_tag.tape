Output src/generated/wrap_with_tag.mp4
Require hx

Hide
Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 600
Set Padding 0
Set Theme "Catppuccin Mocha"
Set TypingSpeed 150ms
Type "hx -c src/generated/helix-config.toml src/generated/wrap_with_tag.text"
Enter
Type ":cd src/generated"
Enter
Show

Type "%"
Ctrl+"s"
Type "I"
Type "<"
Type "l"
Type "i"
Type ">"
Escape
Type "%"
Ctrl+"s"
Type "A"
Type "<"
Type "/"
Type "l"
Type "i"
Type ">"
Escape

Escape
Type ","

Hide
Type ":w!"
Enter
Show

Sleep 2s