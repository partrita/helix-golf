Output src/generated/replace_regex_literal.mp4
Require hx

Hide
Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 600
Set Padding 0
Set Theme "Catppuccin Mocha"
Set TypingSpeed 150ms
Type "hx -c src/generated/helix-config.toml src/generated/replace_regex_literal.text"
Enter
Type ":cd src/generated"
Enter
Show

Type "%"
Type "s"
Type "C"
Type "\"
Type "+"
Type "\"
Type "+"
Enter
Type "c"
Type "R"
Type "u"
Type "s"
Type "t"
Escape

Escape
Type ","

Hide
Type ":w!"
Enter
Show

Sleep 2s