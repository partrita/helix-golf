Output src/generated/swap_quoted_strings.mp4
Require hx

Hide
Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 600
Set Padding 0
Set Theme "Catppuccin Mocha"
Set TypingSpeed 150ms
Type "hx -c src/generated/helix-config.toml src/generated/swap_quoted_strings.text"
Enter
Type ":cd src/generated"
Enter
Show

Type "/"
Type "f"
Type "o"
Type "o"
Enter
Type `"`
Type "a"
Type "y"
Type "/"
Type "b"
Type "a"
Type "r"
Enter
Type `"`
Type "b"
Type "y"
Type `"`
Type "a"
Type "R"
Type "/"
Type "f"
Type "o"
Type "o"
Enter
Type `"`
Type "b"
Type "R"

Escape
Type ","

Hide
Type ":w!"
Enter
Show

Sleep 2s