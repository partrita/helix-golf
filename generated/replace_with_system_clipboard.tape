Output src/generated/replace_with_system_clipboard.mp4
Require hx

Hide
Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 600
Set Padding 0
Set Theme "Catppuccin Mocha"
Set TypingSpeed 150ms
Type "hx -c src/generated/helix-config.toml src/generated/replace_with_system_clipboard.rs"
Enter
Type ":cd src/generated"
Enter
Show

Type "/"
Type "R"
Type "u"
Type "s"
Type "t"
Enter
Type " "
Type "y"
Type "g"
Type "g"
Type "/"
Type "w"
Type "o"
Type "r"
Type "l"
Type "d"
Enter
Type " "
Type "R"

Escape
Type ","

Hide
Type ":w!"
Enter
Show

Sleep 2s